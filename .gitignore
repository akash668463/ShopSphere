## A streamlined .gitignore for modern .NET projects updated for your specific structure

# Fix: Force Git to look one level up (..) to find and ignore the root cache folder
../.vs/

# Standard Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core & Tools
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg
*.snupkg
.env
~$*
*~
CodeCoverage/
*.binlog

# Testing frameworks
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Ignore any .vs folder anywhere in the repository tree
.vs/
**/.vs/
**/CopilotIndices/
*.db
*.db-shm
*.db-wal
